// 临时归档裁决检视脚本：解码转录 → 用户消息概览 + 信号命中（用完即删）
import { locateTranscript, decodeTranscript, extractUtterance } from './scripts/archive-lib.mjs';

const sids = [
  '9ecc8a23-5e6a-455a-a337-8b20a6f1a202',
  '97eab4f7-8e2d-471b-83c1-92b32a5cd35c',
  '782408e9-7863-4a5d-a2f4-3bbd0c26d937',
  '795101a7-ae55-4556-8304-2fe957378a77',
  '9c7da231-25b6-446b-8e80-974ab39a4d80',
  '7454d9cb-13c2-494d-8777-bd1fefa0c09b',
  '107583d5-d586-4983-b944-0f5b680091cb',
  '6140a515-c241-440e-9230-92d2b1946d66',
  '1c1f0103-2864-4909-ade4-4cc9cc41a42c',
  '9f98517c-d5c3-4a31-a105-0a58504f1b70',
];

const SIG = /(坑|失败|error|Error|ERROR|根因|修复|教训|SOP|决策|排查|解决|ENOENT|EACCES|crash|崩溃|卸载|注入|memo|Memo|记忆|配置|环境|装|无法|遗留|残留|安装|卸)/;

const clip = (s, n) => s.replace(/\s+/g, ' ').slice(0, n);

for (const sid of sids) {
  const file = await locateTranscript(sid);
  if (!file) { console.log(`\n===== ${sid} : TRANSCRIPT NOT FOUND =====`); continue; }
  let text = '';
  try { text = await decodeTranscript(file); } catch (e) { console.log(`\n===== ${sid} : DECODE FAIL ${e.message} =====`); continue; }
  const lines = text.split('\n').filter(Boolean);
  console.log(`\n===== ${sid.slice(0, 8)} (${lines.length} lines) =====`);

  // 用户消息概览（含开头与结尾）
  let userCount = 0;
  const userMsgs = [];
  for (let i = 0; i < lines.length; i++) {
    let o; try { o = JSON.parse(lines[i]); } catch { continue; }
    const t = String(o?.type || '');
    const d = o?.data || o;
    const role = String(d?.role || (t.startsWith('user') ? 'user' : t.startsWith('assistant') ? 'assistant' : ''));
    if (role !== 'user') continue;
    const u = extractUtterance(lines[i]);
    if (!u || u.length < 4) continue;
    if (/^</.test(u.trim()) && /system-reminder|skill_content|tool_result/i.test(u.slice(0, 400))) continue; // 注入块降噪
    userCount++;
    userMsgs.push({ row: i + 1, u: clip(u, 110) });
  }
  const head = userMsgs.slice(0, 6), tail = userMsgs.slice(-3);
  for (const m of head) console.log(`  [U ${m.row}] ${m.u}`);
  if (userMsgs.length > 9) console.log(`  ... (${userCount} user msgs) ...`);
  for (const m of tail.slice(head.length >= userMsgs.length ? head.length : -3)) { /* no-op */ }
  if (userMsgs.length > 6) for (const m of userMsgs.slice(-3)) console.log(`  [U* ${m.row}] ${m.u}`);

  // 信号命中（全量行）
  let hits = 0;
  for (let i = 0; i < lines.length; i++) {
    const u = extractUtterance(lines[i]);
    if (!u) continue;
    const s = clip(u, 120);
    if (SIG.test(s) && s.length > 10) {
      hits++;
      if (hits <= 14) console.log(`  [S ${i + 1}] ${s}`);
    }
  }
  console.log(`  (signal-ish lines: ${hits})`);
}
