// 深挖：候选会话的结论段（尾部）与关键行上下文
import { locateTranscript, decodeTranscript, extractUtterance } from './scripts/archive-lib.mjs';

const targets = [
  { sid: '9ecc8a23-5e6a-455a-a337-8b20a6f1a202', focus: [200, 260] },
  { sid: '782408e9-7863-4a5d-a2f4-3bbd0c26d937', focus: [100, 207] },
  { sid: '97eab4f7-8e2d-471b-83c1-92b32a5cd35c', focus: [100, 310] },
  { sid: '107583d5-d586-4983-b944-0f5b680091cb', focus: [700, 940] },
  { sid: '6140a515-c241-440e-9230-92d2b1946d66', focus: [600, 696] },
  { sid: '9f98517c-d5c3-4a31-a105-0a58504f1b70', focus: [90, 151] },
];

const clip = (s, n) => s.replace(/\s+/g, ' ').slice(0, n);

for (const { sid, focus } of targets) {
  const file = await locateTranscript(sid);
  const text = await decodeTranscript(file);
  const lines = text.split('\n').filter(Boolean);
  console.log(`\n########## ${sid.slice(0, 8)} (${lines.length} lines) ##########`);
  // 尾部对话（最后 25 条有正文行）
  const talks = [];
  for (let i = 0; i < lines.length; i++) {
    let o; try { o = JSON.parse(lines[i]); } catch { continue; }
    const t = String(o?.type || '');
    if (t.startsWith('todo') || t.startsWith('session') || t.startsWith('telemetry') || t.startsWith('compaction') || t.startsWith('message-feedback') || t.startsWith('tool-progress')) continue;
    const d = o?.data || o;
    const role = String(d?.role || (t.startsWith('user') ? 'user' : t.startsWith('assistant') ? 'assistant' : ''));
    if (role !== 'user' && role !== 'assistant') continue;
    const u = extractUtterance(lines[i]);
    if (!u || u.length < 10) continue;
    if (/^</.test(u.trim()) && /system-reminder|hindsight_knowledge|tool_result|skill_content/i.test(u.slice(0, 300))) continue;
    talks.push({ row: i + 1, role: role === 'user' ? 'U' : 'A', u });
  }
  const tail = talks.slice(-14);
  for (const m of tail) console.log(`  [${m.role} ${m.row}] ${clip(m.u, 260)}`);
  // focus 区间里的 assistant 长结论
  console.log('  --- focus range assistant conclusions ---');
  let shown = 0;
  for (let i = focus[0] - 1; i < Math.min(focus[1], lines.length); i++) {
    let o; try { o = JSON.parse(lines[i]); } catch { continue; }
    const t = String(o?.type || '');
    const d = o?.data || o;
    const role = String(d?.role || (t.startsWith('assistant') ? 'assistant' : ''));
    if (role !== 'assistant') continue;
    const u = extractUtterance(lines[i]);
    if (!u || u.length < 120) continue;
    console.log(`  [A ${i + 1}] ${clip(u, 420)}`);
    if (++shown >= 10) break;
  }
}
